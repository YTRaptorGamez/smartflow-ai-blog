# ====================================================================
# SmartFlow AI Platform - Environment Variables
# Optimized for $0/Month Free Tier (Vercel + Supabase + Google Gemini)
# ====================================================================

# 1. Supabase Configuration (Free Tier PostgreSQL + Auth)
# Get these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-key"

# 2. Google Gemini API (Free Tier from Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
# Supported models: gemini-2.5-flash, gemini-1.5-flash, gemini-2.0-flash, or gemini-3.5-flash-lite
GEMINI_MODEL="gemini-2.5-flash"

# 3. Cron & Automation Security
# Random secure secret string used in 'Authorization: Bearer <CRON_SECRET>' header
CRON_SECRET="smartflow_cron_secret_change_me_in_production_123"

# 4. Admin Dashboard Security
# Optional admin passcode or admin email to authorize admin actions
ADMIN_EMAIL="keegan@example.com"
ADMIN_SECRET="admin_secret_passcode_9988"

# 5. Site & Canonical Domain
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="SmartFlow AI"
NEXT_PUBLIC_SITE_DESCRIPTION="Autonomous AI workflows, budget tech setups, and developer stacks for creators & solopreneurs."

# 6. Monetization / Google AdSense (Optional)
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-0000000000000000"
NEXT_PUBLIC_ENABLE_ADS="true"
NEXT_PUBLIC_ENABLE_AFFILIATE_INJECTION="true"
